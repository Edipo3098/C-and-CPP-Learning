execute_process(COMMAND "${PROGRAM}" INPUT_FILE "${INPUT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(CASE STREQUAL "valid")
    if(NOT result STREQUAL "0" OR NOT output MATCHES "Mean: 3[\r\n]+Median: 3" OR NOT output MATCHES "Mean: 25[\r\n]+Median: 25")
        message(FATAL_ERROR "Incorrect independent student statistics: ${output} ${error}")
    endif()
else()
    if(NOT result STREQUAL "1" OR NOT error MATCHES "Grade count must be positive")
        message(FATAL_ERROR "Zero grade count was not rejected: ${result} ${output} ${error}")
    endif()
endif()
